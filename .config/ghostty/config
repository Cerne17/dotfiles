# cerne.pro brand config for Ghostty. Colors live in themes/cerne (dark) and
# themes/cerne-light — this line auto-switches with macOS appearance.
theme = dark:cerne,light:cerne-light

cursor-style = block

font-family = MesloLGS NF
font-size = 14

window-padding-x = 10
window-padding-y = 8

# Send Option as Alt rather than composing accented characters. Without this
# the <M-j>/<M-k> line-move mappings in Neovim never arrive.
macos-option-as-alt = true

# Selecting already highlights it; put it on the clipboard too.
copy-on-select = clipboard

# ~100MB of scrollback. tmux keeps its own 50k lines, this covers bare shells.
scrollback-limit = 100000000

mouse-hide-while-typing = true
window-save-state = always

# Dropdown terminal on Cmd+` from any app (the key is "backquote"; "grave"
# is rejected by Ghostty 1.3.1).
keybind = global:cmd+backquote=toggle_quick_terminal
